{
  "name": "@jharmelink/list",
  "description": "Array management using a list object",
  "version": "1.0.35",
  "author": "Jan Willem Harmelink",
  "license": "GPL-3.0-only",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jharmelink/list.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "tsc && vite build --watch",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prebuild": "rimraf dist",
    "release": "npx semantic-release",
    "test": "vitest run --typecheck",
    "test:coverage": "vitest run --coverage --typecheck",
    "test:update": "vitest run -u --typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@fission-ai/openspec": "^1.3.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "replace-json-property": "^1.9.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
